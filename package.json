{
    "name": "ai-company-knowledge-operations-assistant",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node ./node_modules/next/dist/bin/next dev",
        "build": "node ./node_modules/next/dist/bin/next build",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:frontend": "vitest run",
        "check:frontend": "node ./node_modules/eslint/bin/eslint.js . && node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vitest/vitest.mjs run && node ./node_modules/next/dist/bin/next build",
        "test:authorization:live": "node scripts/live-authorization-phase1.mjs",
        "db:migration:safety": "node scripts/check-migration-safety.mjs",
        "db:push:production": "node scripts/production-db-push.mjs",
        "db:types": "npx supabase gen types typescript --project-id gcunbxduzixilquodcow > lib/database.generated.types.ts",
        "db:advisors": "npx supabase db advisors",
        "db:lint": "npx supabase db lint"
    },
    "dependencies": {
        "@supabase/ssr": "^0.12.3",
        "@supabase/supabase-js": "^2.110.7",
        "@upstash/redis": "^1.38.1",
        "lucide-react": "^0.468.0",
        "next": "^15.1.0",
        "nodemailer": "^9.0.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.10.0",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.17.0",
        "eslint-config-next": "^15.1.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vitest": "^4.1.10"
    }
}
